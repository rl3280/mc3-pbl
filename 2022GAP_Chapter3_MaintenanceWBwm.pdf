); transform-origin: 0% 0% 0px;" dir="ltr">§28</div><div data-canvas-width="6.909750000000001" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 181.499px; top: 679px; transform: rotate(0deg) scale(1.08035, 1); transform-origin: 0% 0% 0px;" dir="ltr">-</div><div data-canvas-width="96.87137500000001" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 188.242px; top: 679px; transform: rotate(0deg) scale(0.926999, 1); transform-origin: 0% 0% 0px;" dir="ltr">318.4 Fees.</div><div data-canvas-width="686.5013" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 292.988px; top: 679px; transform: rotate(0deg) scale(0.849258, 1); transform-origin: 0% 0% 0px;" dir="ltr">The department may charge filing fees for the certifications required by section 28</div><div data-canvas-width="6.909750000000001" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 996.671px; top: 679px; transform: rotate(0deg) scale(1.08035, 1); transform-origin: 0% 0% 0px;" dir="ltr">-</div><div data-canvas-width="123.68452500000002" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 1003.74px; top: 679px; transform: rotate(0deg) scale(0.898571, 1); transform-origin: 0% 0% 0px;" dir="ltr">318.3.3, as set </div><div data-canvas-width="296.183425" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.979px; top: 703.008px; transform: rotate(0deg) scale(0.835153, 1); transform-origin: 0% 0% 0px;" dir="ltr">forth in the rules of the department.</div><div data-canvas-width="31.4985" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.979px; top: 741.499px; transform: rotate(0deg) scale(0.919105, 1); transform-origin: 0% 0% 0px;" dir="ltr">§28</div><div data-canvas-width="6.909750000000001" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 181.478px; top: 741.499px; transform: rotate(0deg) scale(1.08035, 1); transform-origin: 0% 0% 0px;" dir="ltr">-</div><div data-canvas-width="173.37247500000004" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 188.222px; top: 741.499px; transform: rotate(0deg) scale(0.915196, 1); transform-origin: 0% 0% 0px;" dir="ltr">318.5 Enforcement.</div><div data-canvas-width="752.8348999999998" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 367.211px; top: 741.499px; transform: rotate(0deg) scale(0.850281, 1); transform-origin: 0% 0% 0px;" dir="ltr">Failure to submit a certification required by this article shall be classified as a major viola-</div><div data-canvas-width="37.663325" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.959px; top: 765.507px; transform: rotate(0deg) scale(0.85155, 1); transform-origin: 0% 0% 0px;" dir="ltr">tion.</div><div data-canvas-width="130.3515" data-font-name="g_font_1244_0" data-angle="0" style="font-size: 20.75px; font-family: sans-serif; left: 571.951px; top: 841.265px; transform: rotate(0deg) scale(1.08157, 1); transform-origin: 0% 0% 0px;" dir="ltr">ARTICLE 319</div><div data-canvas-width="600.6336500000001" data-font-name="g_font_1244_0" data-angle="0" style="font-size: 20.75px; font-family: sans-serif; left: 337.207px; top: 865.273px; transform: rotate(0deg) scale(1.06531, 1); transform-origin: 0% 0% 0px;" dir="ltr">MAINTENANCE AND REMOVAL OF SMALL WIND TURBINES</div><div data-canvas-width="31.4985" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.959px; top: 901.772px; transform: rotate(0deg) scale(0.919105, 1); transform-origin: 0% 0% 0px;" dir="ltr">§28</div><div data-canvas-width="6.909750000000001" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 181.457px; top: 901.772px; transform: rotate(0deg) scale(1.08035, 1); transform-origin: 0% 0% 0px;" dir="ltr">-</div><div data-canvas-width="173.12140000000002" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 188.201px; top: 901.772px; transform: rotate(0deg) scale(0.90947, 1); transform-origin: 0% 0% 0px;" dir="ltr">319.1 Maintenance.</div><div data-canvas-width="751.3035500000004" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 367.937px; top: 901.772px; transform: rotate(0deg) scale(0.845151, 1); transform-origin: 0% 0% 0px;" dir="ltr">The owner of a small wind turbine or small wind turbine tower, as such terms are defined </div><div data-canvas-width="990.97435" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.938px; top: 925.78px; transform: rotate(0deg) scale(0.848634, 1); transform-origin: 0% 0% 0px;" dir="ltr">in chapter 2 of the New York city building code, shall maintain such turbine and tower in accordance with department </div><div data-canvas-width="45.59397500000001" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.938px; top: 949.788px; transform: rotate(0deg) scale(0.833401, 1); transform-origin: 0% 0% 0px;" dir="ltr">rules.</div><div data-canvas-width="31.4985" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.938px; top: 988.279px; transform: rotate(0deg) scale(0.919105, 1); transform-origin: 0% 0% 0px;" dir="ltr">§28</div><div data-canvas-width="6.909750000000001" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 181.436px; top: 988.279px; transform: rotate(0deg) scale(1.08035, 1); transform-origin: 0% 0% 0px;" dir="ltr">-</div><div data-canvas-width="136.369" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 188.18px; top: 988.279px; transform: rotate(0deg) scale(0.923492, 1); transform-origin: 0% 0% 0px;" dir="ltr">319.2 Removal.</div><div data-canvas-width="181.90902500000004" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 331.417px; top: 988.279px; transform: rotate(0deg) scale(0.859751, 1); transform-origin: 0% 0% 0px;" dir="ltr">The owner of a small </div><div data-canvas-width="41.601675" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 518.41px; top: 988.279px; transform: rotate(0deg) scale(0.826181, 1); transform-origin: 0% 0% 0px;" dir="ltr">wind</div><div data-canvas-width="551.6200750000002" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 566.411px; top: 988.279px; transform: rotate(0deg) scale(0.86017, 1); transform-origin: 0% 0% 0px;" dir="ltr">turbine, as such term is defined in chapter 2 of the New York city </div><div data-canvas-width="408.32265" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.917px; top: 1012.29px; transform: rotate(0deg) scale(0.848757, 1); transform-origin: 0% 0% 0px;" dir="ltr">building code, shall remove such turbine when (i</div><div data-canvas-width="567.35065" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 557.675px; top: 1012.29px; transform: rotate(0deg) scale(0.849433, 1); transform-origin: 0% 0% 0px;" dir="ltr">) the time elapsed since installation exceeds the manufacturer’s sug-</div><div data-canvas-width="981.1928" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.917px; top: 1036.29px; transform: rotate(0deg) scale(0.85116, 1); transform-origin: 0% 0% 0px;" dir="ltr">gested useful life of such turbine or (ii) such turbine has been continuously inoperable for 12 months or more, which-</div><div data-canvas-width="591.5119500000001" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.917px; top: 1060.05px; transform: rotate(0deg) scale(0.846251, 1); transform-origin: 0% 0% 0px;" dir="ltr">ever occurs sooner, provided that the commissioner shall by rule establ</div><div data-canvas-width="375.2927999999999" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 745.67px; top: 1060.05px; transform: rotate(0deg) scale(0.841778, 1); transform-origin: 0% 0% 0px;" dir="ltr">ish a timeframe for removing small wind tur-</div><div data-canvas-width="508.053375" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.917px; top: 1084.06px; transform: rotate(0deg) scale(0.849203, 1); transform-origin: 0% 0% 0px;" dir="ltr">bines that do not have manufacturer’s suggested useful lives.</div><div data-canvas-width="130.3515" data-font-name="g_font_1244_0" data-angle="0" style="font-size: 20.75px; font-family: sans-serif; left: 571.931px; top: 1160.07px; transform: rotate(0deg) scale(1.08157, 1); transform-origin: 0% 0% 0px;" dir="ltr">ARTICLE 320</div><div data-canvas-width="441.03294999999997" data-font-name="g_font_1244_0" data-angle="0" style="font-size: 20.75px; font-family: sans-serif; left: 421.929px; top: 1184.08px; transform: rotate(0deg) scale(1.05321, 1); transform-origin: 0% 0% 0px;" dir="ltr">BUILDING ENERGY AND EMISSIONS LIMITS</div><div data-canvas-width="31.4985" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.938px; top: 1220.58px; transform: rotate(0deg) scale(0.919105, 1); transform-origin: 0% 0% 0px;" dir="ltr">§28</div><div data-canvas-width="6.909750000000001" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 181.436px; top: 1220.58px; transform: rotate(0deg) scale(1.08035, 1); transform-origin: 0% 0% 0px;" dir="ltr">-</div><div data-canvas-width="154.618625" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 188.18px; top: 1220.58px; transform: rotate(0deg) scale(0.910861, 1); transform-origin: 0% 0% 0px;" dir="ltr">320.1 Definitions.</div><div data-canvas-width="651.8778500000002" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 347.934px; top: 1220.58px; transform: rotate(0deg) scale(0.857781, 1); transform-origin: 0% 0% 0px;" dir="ltr" class="">As used in this article, the following terms shall have the following meanings:</div><div data-canvas-width="34.49999999999999" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 23px; font-family: serif; left: 150px; top: 1258.5px; transform: rotate(0deg) scale(1.11066, 1); transform-origin: 0% 0% 0px;" dir="ltr">‡‡‡</div><div data-canvas-width="236.17650000000006" data-font-name="g_font_1250_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 192.24px; top: 1260.75px; transform: rotate(0deg) scale(1.02844, 1); transform-origin: 0% 0% 0px;" dir="ltr">BUILDING EMISSIONS. </div><div data-canvas-width="672.0738249999999" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 433.749px; top: 1260.75px; transform: rotate(0deg) scale(0.852052, 1); transform-origin: 0% 0% 0px;" dir="ltr">The term “building emissions” means greenhouse gas emissions as expressed in </div><div data-canvas-width="976.3912499999999" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.993px; top: 1285.5px; transform: rotate(0deg) scale(0.848007, 1); transform-origin: 0% 0% 0px;" dir="ltr">metric tons of carbon dioxide equivalent emitted as a result of operating a covered building and calculated in accord-</div><div data-canvas-width="526.0560750000001" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.993px; top: 1309.26px; transform: rotate(0deg) scale(0.836587, 1); transform-origin: 0% 0% 0px;" dir="ltr">ance with rules promulgated by the department in consultation </div><div data-canvas-width="421.32874999999984" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 693.417px; top: 1309.26px; transform: rotate(0deg) scale(0.85694, 1); transform-origin: 0% 0% 0px;" dir="ltr" class="">with the mayor’s office of long term planning and </div><div data-canvas-width="977.480625" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.993px; top: 1333.27px; transform: rotate(0deg) scale(0.852423, 1); transform-origin: 0% 0% 0px;" dir="ltr" class="">sustainability. The term “building emissions” shall not include greenhouse gas emissions emitted during a local state </div><div data-canvas-width="740.62975" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.993px; top: 1357.28px; transform: rotate(0deg) scale(0.851931, 1); transform-origin: 0% 0% 0px;" dir="ltr">of emergency declared by the mayor pursuant to section 24 of the executive law or a stat</div><div data-canvas-width="235.680575" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 893.486px; top: 1357.28px; transform: rotate(0deg) scale(0.856955, 1); transform-origin: 0% 0% 0px;" dir="ltr">e of emergency declared by </div><div data-canvas-width="981.5061250000001" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.993px; top: 1381.29px; transform: rotate(0deg) scale(0.848763, 1); transform-origin: 0% 0% 0px;" dir="ltr" class="">the governor pursuant to section 28 of the executive law, where such local or state emergency has an impact on build-</div><div data-canvas-width="119.37060000000001" data-font-name="g_font_1246_0" data-angle="0" style="font-size: 20.75px; font-family: serif; left: 149.993px; top: 1405.29px; transform: rotate(0deg) scale(0.86266, 1); transform-origin: 0% 0% 0px;" dir="ltr">ing emissions.</div></div><div class="annotationLayer"><a style="border-width: 0px; border-color: rgb(0, 0, 0); border-style: solid; width: 97.288px; height: 18.499px; left: 214.452px; top: 83.499px; position: absolute; transform: matrix(1.66667, 0, 0, 1.66667, 0, 0); transform-origin: -214.452px -83.499px 0px;" href="https://www.nyc.gov/assets/buildings/local_laws/ll138of2021.pdf"></a><a style="border-width: 0px; border-color: rgb(0, 0, 0); border-style: solid; width: 99.788px; height: 18.499px; left: 230.009px; top: 101.998px; position: absolute; transform: matrix(1.66667, 0, 0, 1.66667, 0, 0); transform-origin: -230.009px -101.998px 0px;" href="https://www.nyc.gov/assets/buildings/local_laws/ll142of2025.pdf"></a><a style="border-width: 0px; border-color: rgb(0, 0, 0); border-style: solid; width: 97.288px; height: 18.499px; left: 214.452px; top: 210.491px; position: absolute; transform: matrix(1.66667, 0, 0, 1.66667, 0, 0); transform-origin: -214.452px -210.491px 0px;" href="https://www.nyc.gov/assets/buildings/local_laws/ll138of2021.pdf"></a><a style="border-width: 0px; border-color: rgb(0, 0, 0); border-style: solid; width: 97.288px; height: 18.499px; left: 206.952px; top: 304.984px; position: absolute; transform: matrix(1.66667, 0, 0, 1.66667, 0, 0); transform-origin: -206.952px -304.984px 0px;" href="https://www.nyc.gov/assets/buildings/local_laws/ll138of2021.pdf"></a></div></div><a name="33"></a><div id="pageContainer33" class="page" style="width: 1019px; height: 1319px;"><div class="loadingIcon"></div></div><a name="34"></a><div id="pageContainer34" class="page" style="width: 1019px; height: 1319px;"><div class="loadingIcon"></div></div><a name="35"></a><div id="pageContainer35" class="page" style="width: 1019px; height: 1319px;">